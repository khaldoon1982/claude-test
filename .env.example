# ============================================
# REFURBX E-COMMERCE - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# --------------------------------------------
# NEXT.JS
# --------------------------------------------
# Your site URL (used for canonical URLs, sitemaps, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------
# SUPABASE
# --------------------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (NEVER expose to client! Server-only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database direct connection (optional, for migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --------------------------------------------
# TYPESENSE (Search Engine)
# --------------------------------------------
# Get these from: https://cloud.typesense.org/
NEXT_PUBLIC_TYPESENSE_HOST=xxx.a1.typesense.net
NEXT_PUBLIC_TYPESENSE_PORT=443
NEXT_PUBLIC_TYPESENSE_PROTOCOL=https

# Search-only API key (safe to expose to client)
NEXT_PUBLIC_TYPESENSE_SEARCH_API_KEY=your-search-only-key

# Admin API key (NEVER expose to client! Server-only)
TYPESENSE_ADMIN_API_KEY=your-admin-key-here

# --------------------------------------------
# RESEND (Email Service)
# --------------------------------------------
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email sender (must be verified domain)
RESEND_FROM_EMAIL=orders@refurbx.nl
RESEND_FROM_NAME=RefurbX

# Admin notification email
ADMIN_EMAIL=admin@refurbx.nl

# --------------------------------------------
# STRIPE (Payment Provider)
# --------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Webhook signing secret (from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# --------------------------------------------
# MOLLIE (Alternative Payment Provider)
# --------------------------------------------
# Get from: https://www.mollie.com/dashboard/developers/api-keys
MOLLIE_API_KEY=test_your_key_here

# Webhook endpoint (Mollie will call this after payment)
MOLLIE_WEBHOOK_URL=https://yourdomain.com/api/webhooks/mollie

# --------------------------------------------
# i18n (Internationalization)
# --------------------------------------------
# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE=nl

# Supported locales (comma-separated)
NEXT_PUBLIC_LOCALES=nl,en,ar

# --------------------------------------------
# BUSINESS SETTINGS
# --------------------------------------------
# Company details
COMPANY_NAME=RefurbX B.V.
COMPANY_VAT_NUMBER=NL123456789B01
COMPANY_KVK_NUMBER=12345678

# Default VAT rate (percentage)
DEFAULT_VAT_RATE=21.00

# Free shipping threshold (in cents, e.g., 7500 = €75.00)
FREE_SHIPPING_THRESHOLD_CENTS=7500

# Standard shipping cost (in cents)
STANDARD_SHIPPING_CENTS=595

# Express shipping cost (in cents)
EXPRESS_SHIPPING_CENTS=995

# --------------------------------------------
# SECURITY
# --------------------------------------------
# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your-random-secret-here

# Rate limiting (requests per minute)
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# CORS allowed origins (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:3000,https://refurbx.nl

# --------------------------------------------
# ANALYTICS & MONITORING
# --------------------------------------------
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (Error tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# --------------------------------------------
# FEATURE FLAGS
# --------------------------------------------
# Enable/disable features
ENABLE_GUEST_CHECKOUT=true
ENABLE_NEWSLETTER=true
ENABLE_REVIEWS=false
ENABLE_WISHLIST=false

# --------------------------------------------
# DEVELOPMENT
# --------------------------------------------
# Show debug info in development
DEBUG=false

# Skip email sending in development (logs to console instead)
SKIP_EMAIL_SEND=true

# Use Stripe test mode
STRIPE_TEST_MODE=true

# --------------------------------------------
# PRODUCTION ONLY
# --------------------------------------------
# Vercel environment variables (auto-populated)
# VERCEL_URL=your-deployment.vercel.app
# VERCEL_ENV=production

# Render webhook server URL
# WEBHOOK_SERVER_URL=https://your-app.onrender.com
